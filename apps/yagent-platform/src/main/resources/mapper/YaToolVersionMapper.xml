<?xml version="1.0" encoding="UTF-8"?><!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yagent.platform.mapper.YaToolVersionMapper">
    <select id="selectPublished" resultType="com.yagent.platform.domain.YaToolVersion">SELECT * FROM ya_tool_version
        WHERE tool_id=#{toolId} AND version=#{version} AND status='PUBLISHED' LIMIT 1
    </select>
</mapper>

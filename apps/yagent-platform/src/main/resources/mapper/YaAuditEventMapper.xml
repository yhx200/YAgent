<?xml version="1.0" encoding="UTF-8"?><!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yagent.platform.mapper.YaAuditEventMapper">
    <insert id="insert" parameterType="com.yagent.platform.domain.YaAuditEvent" useGeneratedKeys="true"
            keyProperty="id">INSERT INTO
        ya_audit_event(trace_id,tenant_id,user_id,session_id,event_type,capability_code,tool_id,tool_version,tool_name,result_status,duration_ms,detail_json,create_time)
        VALUES(#{traceId},#{tenantId},#{userId},#{sessionId},#{eventType},#{capabilityCode},#{toolId},#{toolVersion},#{toolName},#{resultStatus},#{durationMs},#{detailJson},NOW())
    </insert>
</mapper>

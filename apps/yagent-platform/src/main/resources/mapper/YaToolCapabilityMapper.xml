<?xml version="1.0" encoding="UTF-8"?><!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yagent.platform.mapper.YaToolCapabilityMapper">
    <select id="selectByCapabilityCodes" resultType="com.yagent.platform.domain.YaToolCapability">SELECT * FROM
        ya_tool_capability WHERE capability_code IN <foreach collection="codes" item="c" open="(" separator=","
                                                             close=")">#{c}
        </foreach> ORDER BY priority ASC
    </select>
    <select id="selectByCapabilityCode" resultType="com.yagent.platform.domain.YaToolCapability">SELECT * FROM
        ya_tool_capability WHERE capability_code=#{code} ORDER BY priority ASC
    </select>
</mapper>

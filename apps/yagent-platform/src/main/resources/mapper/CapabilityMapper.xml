<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.yagent.platform.mapper.capability.CapabilityMapper">

    <resultMap id="BaseResultMap"
               type="com.yagent.platform.domain.CapabilityDO">

        <id column="id"
            property="id"/>

        <result column="capability_code"
                property="capabilityCode"/>

        <result column="capability_name"
                property="capabilityName"/>

        <result column="description"
                property="description"/>

        <result column="keywords"
                property="keywords"/>

        <result column="provider_type"
                property="providerType"/>

        <result column="tool_id"
                property="toolId"/>

        <result column="status"
                property="status"/>

        <result column="create_time"
                property="createTime"/>

        <result column="update_time"
                property="updateTime"/>

    </resultMap>


    <select id="selectAllEnabled"
            resultMap="BaseResultMap">

        SELECT
        id,
        capability_code,
        capability_name,
        description,
        keywords,
        provider_type,
        tool_id,
        status,
        create_time,
        update_time

        FROM ya_capability

        WHERE status = 'ENABLED'

    </select>

</mapper>

<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.yagent.platform.mapper.tool.ToolVersionMapper">

    <resultMap id="BaseResultMap"
               type="com.yagent.platform.domain.ToolVersionDO">

        <id column="id"
            property="id"/>

        <result column="tool_id"
                property="toolId"/>

        <result column="version"
                property="version"/>

        <result column="manifest_json"
                property="manifestJson"/>

        <result column="bucket"
                property="bucket"/>

        <result column="object_key"
                property="objectKey"/>

        <result column="sha256"
                property="sha256"/>

        <result column="signature"
                property="signature"/>

        <result column="status"
                property="status"/>

        <result column="create_time"
                property="createTime"/>

        <result column="update_time"
                property="updateTime"/>

    </resultMap>


    <select id="selectByToolIdAndVersion"
            resultMap="BaseResultMap">

        SELECT
        id,
        tool_id,
        version,
        manifest_json,
        bucket,
        object_key,
        sha256,
        signature,
        status,
        create_time,
        update_time

        FROM ya_tool_version

        WHERE tool_id = #{toolId}
        AND version = #{version}

        LIMIT 1

    </select>

</mapper>
